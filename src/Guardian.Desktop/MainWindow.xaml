<Window x:Class="Guardian.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Guardian.Desktop"
        mc:Ignorable="d"
        Title="Guardian Companion" Height="700" Width="980">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="22" FontWeight="SemiBold"
                   Text="Guardian Companion — Editorial Review" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,10">
            <WrapPanel>
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Jellyfin URL" />
                <TextBox x:Name="JellyfinUrlTextBox" Width="220" Text="http://localhost:8096/" />
                <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="Jellyfin token" />
                <PasswordBox x:Name="JellyfinTokenBox" Width="160" />
                <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="TMDb token" />
                <PasswordBox x:Name="TmdbTokenBox" Width="160" />
                <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Text="Editor" />
                <TextBox x:Name="ActorTextBox" Width="120" Text="human-editor" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <Button Width="130" Margin="0,0,8,0" Click="ObserveLibraryClick" Content="Observe library" />
                <Button x:Name="DiscoverButton" Width="150" Margin="0,0,8,0" Click="DiscoverCandidatesClick"
                        Content="Discover Candidates" IsEnabled="False" />
                <Button x:Name="AcceptButton" Width="150" Click="AcceptCandidateClick"
                        Content="Accept selection" IsEnabled="False" />
            </WrapPanel>
        </StackPanel>

        <GroupBox Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Header="Observed SourceWorks">
            <ListBox x:Name="SourceWorksList" SelectionChanged="SourceWorkSelectionChanged" />
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" Header="Review Candidates">
            <ListBox x:Name="CandidatesList" DisplayMemberPath="DisplayText" SelectionChanged="CandidateSelectionChanged" />
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="2" Width="360" Header="Current understanding">
            <TextBox x:Name="ExplanationTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
